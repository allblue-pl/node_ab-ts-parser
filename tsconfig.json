{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "declaration": true,
        "declarationDir": "./ts-types",
        "emitDeclarationOnly": true,
        "erasableSyntaxOnly": true,
        "module": "nodenext",
        "outDir": ".",
        "rewriteRelativeImportExtensions": true,
        "rootDir": ".",
        "strict": true,
        "target": "esnext",
        "typeRoots": [ "./node_modules/@types", "./node_modules/ab-fs-watcher/js-modules", ],
        "types": [ "anymatch", "node"],
        "useDefineForClassFields": true,
        "verbatimModuleSyntax": true
    },
    "exclude": [
        "./index.d.ts",
        "./lib/**/*",
        "./tests/**/*",
        "./ts-types/**/*",
        "./build.ts"
    ]
}